# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=HeyStartup
BOOKING_URL=https://heystartup.co.uk/#contact
ALLOWED_ORIGINS=https://heystartup.co.uk,https://www.heystartup.co.uk
DB_PATH=leads.db

# Password for the /admin dashboard (any username). Use a long random value.
ADMIN_TOKEN=

# Your own WhatsApp number, with country code. New and qualified leads are sent here.
OWNER_WHATSAPP=

# Used when a visitor types a number without a country code.
DEFAULT_COUNTRY_CODE=44

# console = dry run (logs only), waha = self-hosted gateway, cloud = official Meta API
WHATSAPP_PROVIDER=console

# --- Self-hosted WAHA gateway (WHATSAPP_PROVIDER=waha) ---
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Shared secret the gateway sends back on /webhooks/waha?token=...
WEBHOOK_TOKEN=

# --- Official WhatsApp Cloud API (WHATSAPP_PROVIDER=cloud) ---
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_APP_SECRET=
# Approved template names with one body variable (the first name).
WA_CLOUD_WELCOME_TEMPLATE=
WA_CLOUD_FOLLOWUP_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=en_GB

# --- Follow-ups ---
# Hours of silence before each nudge. Two nudges, then the lead is marked cold.
FOLLOWUP_DELAYS_HOURS=24,72
# Nudges only go out on weekdays inside this window.
TIMEZONE=Europe/London
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=19
# Pause between automated sends.
SEND_GAP_SECONDS=5
